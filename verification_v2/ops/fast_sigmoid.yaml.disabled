name: "fast_sigmoid"
# Sigmoid approx: 0.5 * (1 + x / (1 + abs(x)))
formula: "0.5 * (1 + x * (1 + Abs(x))**(-1))"
tensors:
  x:         { bank: 0, role: "input", offset: 0 }
  constants: { bank: 7, role: "constant", offset: 0 }
  y:         { bank: 2, role: "output", offset: 0 }
test_data:
  x: { range: [-10.0, 10.0] }
