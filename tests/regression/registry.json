        "le": {"description": "a <= b", "status": "pending"},
        "eq": {"description": "a == b", "status": "pending"},
        "ne": {"description": "a != b", "status": "pending"},
        "and": {"description": "a & b", "status": "ready"},
        "or": {"description": "a | b", "status": "pending"},
        "xor": {"description": "a ^ b", "status": "pending"},
        "not": {"description": "!a 逻辑非", "status": "pending"}
