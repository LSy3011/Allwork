{
  "_comment": "AIACC 算子回归注册表 V2.0 — 按类别组织，路径自动推导",
  "_convention": {
    "test_script": "tests/operators/{category}/{op_name}/test_{op_name}.py",
    "build_dir": "build/operators/{category}/{op_name}/",
    "说明": "遵循约定 > 配置，只需注册算子名称，路径自动推导"
  },
  "build_root": "build/operators",
  "categories": {
    "unary/transcendentals": {
      "operators": {
        "sin": {"description": "9阶泰勒展开 sin(x)", "status": "ready"},
        "cos": {"description": "cos(x) 泰勒展开", "status": "ready"},
        "tan": {"description": "7阶泰勒展开 tan(x)", "status": "ready"},
        "exp": {"description": "exp(x) 指数函数", "status": "ready"},
        "log": {"description": "5阶泰勒展开 log(x)", "status": "ready"},
        "sqrt": {"description": "5阶泰勒展开 sqrt(x)", "status": "ready"},
        "rsqrt": {"description": "5阶泰勒展开 rsqrt(x)", "status": "ready"},
        "asin": {"description": "7阶泰勒展开 asin(x)", "status": "ready"},
        "acos": {"description": "arccos(x)", "status": "ready"},
        "atan": {"description": "arctan(x)", "status": "ready"},
        "sinh": {"description": "sinh(x) 双曲正弦", "status": "pending"},
        "cosh": {"description": "cosh(x) 双曲余弦", "status": "pending"}
      }
    },
    "unary/math": {
      "operators": {
        "abs": {"description": "abs(x) 绝对值", "status": "ready"},
        "neg": {"description": "neg(x) 取反", "status": "ready"},
        "ceil": {"description": "ceil(x) 向上取整", "status": "pending"},
        "floor": {"description": "floor(x) 向下取整", "status": "pending"},
        "round": {"description": "round(x) 四舍五入", "status": "pending"},
        "sign": {"description": "sign(x) 符号函数", "status": "pending"},
        "square": {"description": "x^2 平方", "status": "ready"},
        "reciprocal": {"description": "1/x 倒数", "status": "pending"}
      }
    },
    "binary/math": {
      "operators": {
        "add": {"description": "a + b", "status": "ready"},
        "sub": {"description": "a - b", "status": "ready"},
        "mul": {"description": "a * b", "status": "ready"},
        "div": {"description": "a / b", "status": "ready"},
        "atan2": {"description": "5阶泰勒展开 atan2(y, x)", "status": "ready"},
        "pow": {"description": "a^b 幂运算", "status": "ready"},
        "fmod": {"description": "fmod(a, b) 浮点取余", "status": "pending"},
